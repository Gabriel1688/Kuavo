[Unit]
Description=Mercury controller SHM producer
Documentation=https://github.com/cognition-x/Kuavo/blob/main/services/mercury-controller
After=network.target

[Service]
Type=simple
# The controller binary path and runtime arguments can be overridden via
# Environment= lines below or by dropping a file into
# /etc/systemd/system/mercury-controller.service.d/.
Environment="MERCURY_CONTROLLER=/usr/local/bin/mercury_controller"
Environment="MERCURY_CONTROLLER_FREQ=200"
Environment="MERCURY_CONTROLLER_DUR=0"
Environment="MERCURY_CONTROLLER_JOINTS=12"
ExecStart=/usr/local/bin/mercury-controller
ExecStartPre=/bin/sh -c '/usr/bin/test -e /dev/shm/mercury_robot_ipc && /bin/rm -f /dev/shm/mercury_robot_ipc || true'
ExecStopPost=/bin/sh -c '/usr/bin/test -e /dev/shm/mercury_robot_ipc && /bin/rm -f /dev/shm/mercury_robot_ipc || true'
Restart=on-failure
RestartSec=2

# Ensure the service owns /dev/shm/mercury_robot_ipc while running.
# The controller itself creates and unlinks the POSIX shared memory segment.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
