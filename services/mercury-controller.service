[Unit]
Description=Mercury controller SHM consumer
Documentation=https://github.com/cognition-x/Kuavo/blob/main/services/mercury-controller
After=network.target Kuavo.service
BindsTo=Kuavo.service

[Service]
Type=simple
# The controller binary path and runtime arguments can be overridden via
# Environment= lines below or by dropping a file into
# /etc/systemd/system/mercury-controller.service.d/.
Environment="MERCURY_CONTROLLER=/usr/local/bin/mercury_controller"
Environment="MERCURY_CONTROLLER_FREQ=200"
Environment="MERCURY_CONTROLLER_DUR=0"
Environment="MERCURY_CONTROLLER_JOINTS=12"
ExecStart=/usr/local/bin/mercury-controller
Restart=on-failure
RestartSec=2

# The controller is a consumer — it attaches to the Robot-owned SHM segment.
# SHM creation, sizing, and cleanup are handled by the Kuavo Robot service.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
