[Unit]
Description=Damiao multi-motor simulator (right leg)
Documentation=https://github.com/cognition-x/Kuavo/blob/main/services/damiao-simulator
After=network.target

[Service]
Type=simple
# The simulator binary and runtime arguments can be overridden via
# Environment= lines below or by dropping a file into
# /etc/systemd/system/damiao-simulator-right.service.d/.
Environment="DAMIAO_SIMULATOR=/usr/local/bin/DamiaoSimulator"
Environment="DAMIAO_SIMULATOR_IDS=7,8,9,10,11,12"
Environment="DAMIAO_SIMULATOR_LOCAL=8888"
Environment="DAMIAO_SIMULATOR_REMOTE=8889"
Environment="DAMIAO_SIMULATOR_IP=127.0.0.1"
Environment="DAMIAO_SIMULATOR_LOG=/var/log/kuavo/damiao-simulator-right.log"
ExecStart=/usr/local/bin/damiao-simulator
Restart=on-failure
RestartSec=2

StandardOutput=journal
StandardError=journal
LogsDirectory=kuavo
LogsDirectoryMode=0755

[Install]
WantedBy=multi-user.target
